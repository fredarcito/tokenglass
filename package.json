  "license": "MIT",
  "private": false,
  "bin": {
    "tokenglass": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "example/",
    "scripts/",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredarcito/tokenglass.git"
  },
  "homepage": "https://github.com/fredarcito/tokenglass#readme",
  "bugs": {
    "url": "https://github.com/fredarcito/tokenglass/issues"
  },
  "scripts": {
